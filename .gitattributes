# Unreal Engine package files — binary, non-mergeable → LFS + lock required
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable
*.upk filter=lfs diff=lfs merge=lfs -text lockable
*.udk filter=lfs diff=lfs merge=lfs -text lockable
*.uexp filter=lfs diff=lfs merge=lfs -text lockable
*.ubulk filter=lfs diff=lfs merge=lfs -text lockable
*.uptnl filter=lfs diff=lfs merge=lfs -text lockable

# Other binary assets
*.fbx filter=lfs diff=lfs merge=lfs -text lockable
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text lockable
*.tga filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Text files — normal git diff/merge, LF line endings
*.uproject text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
